# Variables de entorno de FoodExpress para Docker Compose.
#
#   cp .env.example .env      y cambie las claves antes de levantar el sistema.
#
# El archivo .env real NO se sube al repositorio (está en .gitignore).
# docker compose up se detiene con un mensaje claro si falta alguna variable obligatoria.

# --- Base de datos del servicio de Restaurantes ---
RESTAURANTES_DB_NAME=restaurantes_db
RESTAURANTES_DB_USER=restaurantes
RESTAURANTES_DB_PASSWORD=cambie-esta-clave-1

# --- Base de datos del servicio de Pedidos ---
PEDIDOS_DB_NAME=pedidos_db
PEDIDOS_DB_USER=pedidos
PEDIDOS_DB_PASSWORD=cambie-esta-clave-2

# --- Base de datos del servicio de Notificaciones ---
NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASSWORD=cambie-esta-clave-3

# --- RabbitMQ (los tres servicios usan este usuario) ---
RABBITMQ_USER=foodexpress
RABBITMQ_PASSWORD=cambie-esta-clave-4

# --- Reglas de negocio del servicio de Pedidos (opcionales) ---
# Impuesto sobre platos y extras (0.08 = 8 %) y valor fijo del domicilio en pesos
TASA_IMPUESTO=0.08
COSTO_DOMICILIO=5000

# --- Correo (opcional) ---
# Remitente de los correos que envía Notificaciones
MAIL_FROM=pedidos@foodexpress.local

# --- Datos de ejemplo (opcional) ---
# true: Restaurantes crea dos restaurantes con su menú si la base está vacía
SEED_ENABLED=true
